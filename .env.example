# ── Public company details (shown on the website) ─────────────────────────────
# Leave empty until verified. Empty values render as "pending verification".
NEXT_PUBLIC_SITE_URL=https://malirlogistics.com
NEXT_PUBLIC_LEGAL_NAME_CN=
NEXT_PUBLIC_REGISTRATION_NO=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only, international format, e.g. 8613800000000
NEXT_PUBLIC_WHATSAPP=8615323482585

# ── Inquiry delivery (server-side, never exposed to the browser) ─────────────
# Option A: Resend (https://resend.com) — recommended
RESEND_API_KEY=
# Inbox that receives quote / partner / contact inquiries
INQUIRY_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Malir Website <web@yourdomain.com>"
INQUIRY_FROM_EMAIL=

# Option B: any webhook (Zapier, Make, n8n, Slack, CRM). Receives JSON.
INQUIRY_WEBHOOK_URL=
